# SupportPearlz configuration
#
# The OpenAI API key is entered through the Streamlit UI at runtime and is
# NEVER read from this file by the app. OPENAI_API_KEY below is only used
# as a fallback by the non-interactive evaluation script
# (evaluation/run_eval.py) so it can be run from the command line.
OPENAI_API_KEY=

# All settings below are optional overrides of src/config.py defaults.
SUPPORTPEARLZ_LLM_MODEL=gpt-4o-mini
SUPPORTPEARLZ_EMBEDDING_MODEL=text-embedding-3-small
SUPPORTPEARLZ_TEMPERATURE=0.0
SUPPORTPEARLZ_CHUNK_SIZE=900
SUPPORTPEARLZ_CHUNK_OVERLAP=150
SUPPORTPEARLZ_RETRIEVAL_K=4
SUPPORTPEARLZ_RETRIEVAL_STRATEGY=similarity
SUPPORTPEARLZ_RELEVANCE_THRESHOLD=0.25
SUPPORTPEARLZ_COLLECTION_NAME=supportpearlz_kb
SUPPORTPEARLZ_LOG_LEVEL=INFO
